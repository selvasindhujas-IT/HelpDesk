# -----------------------------------------------------------------------
# AI IT Helpdesk Agent - Environment Configuration Example
# -----------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" file or share your API key publicly.
#
# If LLM_API_KEY is left empty, the application automatically runs in
# DEMO MODE and uses local knowledge-base-driven responses instead of a
# live LLM. All other features (RAG, tools, memory, database) still work.
# -----------------------------------------------------------------------

# Which LLM provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Your LLM API key (leave blank to run in Demo Mode)
LLM_API_KEY=your_api_key_here

# Model name for the selected provider
# Examples: claude-3-5-sonnet-20241022 (Anthropic), gpt-4o-mini (OpenAI)
LLM_MODEL=claude-3-5-sonnet-20241022

# Embedding model used for RAG (Sentence Transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# RAG chunking configuration
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K_RESULTS=3

# Diagnostic tool targets
PING_TARGET_HOST=8.8.8.8
DNS_TEST_HOST=www.google.com
